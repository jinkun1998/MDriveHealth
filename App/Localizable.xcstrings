    "eject.blockers": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang giữ file: %@. Đóng các app này rồi thử lại, hoặc đẩy mạnh (có thể mất dữ liệu chưa lưu của chính các app đó)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Holding files: %@. Close these apps and retry, or force-eject (their unsaved data may be lost)."
