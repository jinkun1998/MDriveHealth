    "Dữ liệu được ghi lại mỗi lần đọc SMART. Hãy để app chạy nền để tích luỹ lịch sử.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu được ghi lại mỗi lần đọc SMART. Hãy để app chạy nền để tích luỹ lịch sử."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A data point is recorded on every SMART read. Keep the app running in the background to build history."
          }
        }
      }
