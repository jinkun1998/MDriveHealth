    "NVMe self-test không khả dụng trên macOS": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "NVMe self-test không khả dụng trên macOS"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NVMe self-test is unavailable on macOS"
          }
        }
      }
    },
    "Giao diện NVMe của macOS không cho phép ứng dụng gửi lệnh Device Self-test — hạn chế của hệ điều hành, áp dụng với mọi công cụ. Các chỉ số SMART ở tab Tổng quan vẫn phản ánh đầy đủ tình trạng ổ.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao diện NVMe của macOS không cho phép ứng dụng gửi lệnh Device Self-test — hạn chế của hệ điều hành, áp dụng với mọi công cụ. Các chỉ số SMART ở tab Tổng quan vẫn phản ánh đầy đủ tình trạng ổ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The macOS NVMe interface does not let applications issue Device Self-test commands — an operating-system limitation that applies to every tool. The SMART metrics on the Overview tab still fully reflect the drive's condition."
          }
        }
      }
    },
    "Không khả dụng": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
