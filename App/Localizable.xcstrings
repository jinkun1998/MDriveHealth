    "Áp lực bộ nhớ NGHIÊM TRỌNG — hãy đóng bớt ứng dụng.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Áp lực bộ nhớ NGHIÊM TRỌNG — hãy đóng bớt ứng dụng."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CRITICAL memory pressure — close some apps."
          }
        }
      }
    },
    "Áp lực bộ nhớ cao — máy bắt đầu nén/swap nhiều.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Áp lực bộ nhớ cao — máy bắt đầu nén/swap nhiều."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "High memory pressure — the Mac is compressing/swapping heavily."
          }
        }
      }
    },
    "Máy Mac này không có pin (desktop) hoặc không đọc được thông tin pin.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy Mac này không có pin (desktop) hoặc không đọc được thông tin pin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac has no battery (desktop) or its battery info can't be read."
          }
        }
      }
    },
    "%1$lld lỗi I/O liên quan tới %2$@ trong kernel log 24 giờ qua — dấu hiệu cần chú ý ngay cả khi SMART chưa báo.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld lỗi I/O liên quan tới %2$@ trong kernel log 24 giờ qua — dấu hiệu cần chú ý ngay cả khi SMART chưa báo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld I/O errors involving %2$@ in the last 24h of kernel logs — worth attention even before SMART flags it."
          }
        }
      }
    },
    "Gợi ý: thử cáp/hộp ổ hỗ trợ SMART passthrough, hoặc theo dõi lỗi I/O nếu ổ hay mất kết nối.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gợi ý: thử cáp/hộp ổ hỗ trợ SMART passthrough, hoặc theo dõi lỗi I/O nếu ổ hay mất kết nối."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: try a cable/enclosure that supports SMART passthrough, or watch for I/O errors if the drive keeps disconnecting."
          }
        }
      }
    },
