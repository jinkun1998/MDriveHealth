        }
      }
    },
    "Đang chạy ở 480 Mb/s (USB 2.0) — kiểm tra lại cáp và cổng: ổ này có thể nhanh hơn nhiều với cáp/cổng USB 3.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang chạy ở 480 Mb/s (USB 2.0) — kiểm tra lại cáp và cổng: ổ này có thể nhanh hơn nhiều với cáp/cổng USB 3."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Running at 480 Mb/s (USB 2.0) — check the cable and port: this drive can be much faster on USB 3."
          }
        }
      }
    },
    "Chip cầu nối này không passthrough SMART — macOS không có driver SAT nên không app nào đọc được chỉ số sức khoẻ qua nó. Vẫn đo được tốc độ và kiểm tra dung lượng thật ở tab Tốc độ.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chip cầu nối này không passthrough SMART — macOS không có driver SAT nên không app nào đọc được chỉ số sức khoẻ qua nó. Vẫn đo được tốc độ và kiểm tra dung lượng thật ở tab Tốc độ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This bridge chip doesn't pass SMART through — macOS has no SAT driver, so no app can read health data across it. Speed tests and the real-capacity check in the Speed tab still work."
          }
        }
      }
    },
    "Độ sâu hàng đợi": {
