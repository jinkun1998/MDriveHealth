    "Chạy self-test": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạy self-test"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run self-test"
          }
        }
      }
    },
    "Self-test do chính firmware ổ đĩa thực hiện, an toàn với dữ liệu và có thể dùng ổ bình thường trong lúc chạy (tốc độ có thể giảm nhẹ).": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Self-test do chính firmware ổ đĩa thực hiện, an toàn với dữ liệu và có thể dùng ổ bình thường trong lúc chạy (tốc độ có thể giảm nhẹ)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Self-tests are executed by the drive firmware itself. They are safe for your data and the drive stays usable while running (throughput may dip slightly)."
          }
        }
      }
    },
    "Test ngắn (~2 phút)": {
