    "notify.degraded.title": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sức khoẻ ổ đĩa giảm: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive health degraded: %@"
          }
        }
      }
    },
    "notify.degraded.body": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tình trạng chuyển từ “%@” xuống “%@” (%lld/100). Hãy sao lưu dữ liệu và kiểm tra chi tiết trong MDriveHealth."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Status changed from “%@” to “%@” (%lld/100). Back up your data and check the details in MDriveHealth."
          }
        }
      }
    },
    "notify.defects.title": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phát hiện lỗi mới: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New defects detected: %@"
          }
        }
      }
    },
    "notify.defects.body": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số sector lỗi/media error tăng từ %lld lên %lld. Đây là dấu hiệu bề mặt lưu trữ đang xuống cấp."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Defective sectors/media errors increased from %lld to %lld — a sign the storage media is degrading."
          }
        }
      }
    },
    "notify.temp.title": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhiệt độ cao: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "High temperature: %@"
          }
        }
      }
    },
    "notify.temp.body": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ổ đĩa đạt %lld°C, vượt ngưỡng cảnh báo %lld°C."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The drive reached %lld°C, above the %lld°C alert threshold."
          }
        }
      }
    },
    "notify.failing.title": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ổ đĩa đang hỏng: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive is failing: %@"
          }
        }
      }
    },
    "notify.failing.body": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tình trạng: %@ (%lld/100). Sao lưu dữ liệu ngay lập tức!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Status: %@ (%lld/100). Back up your data immediately!"
          }
        }
      }
    },
    "risk.actions.title": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc nên làm"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recommended actions"
          }
        }
      }
    },
    "risk.backupNow.action.backup": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sao lưu dữ liệu quan trọng ngay lập tức."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back up important data immediately."
          }
        }
      }
    },
    "risk.backupNow.action.limitWrites": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hạn chế ghi thêm dữ liệu lên ổ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Avoid writing more data to this drive."
          }
        }
      }
    },
    "risk.backupNow.action.replace": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuẩn bị ổ thay thế và kiểm tra lại sau khi backup."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare a replacement drive and recheck after backup."
          }
        }
      }
    },
    "risk.backupNow.message": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ổ này có dấu hiệu hỏng nghiêm trọng. Đừng chạy tác vụ nặng trước khi sao lưu dữ liệu quan trọng."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This drive has serious failure signals. Avoid heavy work before backing up important data."
          }
        }
      }
    },
    "risk.backupNow.title": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup ngay"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back up now"
          }
        }
      }
    },
    "risk.backupSoon.action.backup": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạy backup đầy đủ trong tuần này."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run a full backup this week."
          }
        }
      }
    },
    "risk.backupSoon.action.replace": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu lỗi tiếp tục tăng, thay ổ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace the drive if errors keep increasing."
          }
        }
      }
    },
    "risk.backupSoon.action.watch": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Theo dõi sector/media error trong 24-48 giờ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch sector/media errors for the next 24-48 hours."
          }
        }
      }
    },
    "risk.backupSoon.message": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ổ đang có cảnh báo SMART hoặc dấu hiệu lỗi tăng. Chưa chắc hỏng ngay, nhưng không nên xem nhẹ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SMART is warning or error counters are increasing. It may not fail immediately, but do not ignore it."
          }
        }
      }
    },
    "risk.backupSoon.title": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nên backup trong tuần này"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back up this week"
          }
        }
      }
    },
    "risk.healthy.message": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa thấy dấu hiệu SMART đáng lo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No concerning SMART signals detected."
          }
        }
      }
    },
    "risk.healthy.title": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ổ đang ổn"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive looks good"
          }
        }
      }
    },
    "risk.noSmart.action.permission": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra quyền truy cập thiết bị lưu trữ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check storage device access permissions."
          }
        }
      }
    },
    "risk.noSmart.action.refresh": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bấm Làm mới."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click Refresh."
          }
        }
      }
    },
    "risk.noSmart.message": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bấm Làm mới để đọc lại SMART. Nếu vẫn lỗi, xem thông báo lỗi trong tab Tổng quan."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click Refresh to read SMART again. If it still fails, check the error in the Overview tab."
          }
        }
      }
    },
    "risk.noSmart.title": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có dữ liệu SMART"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No SMART data yet"
          }
        }
      }
    },
    "risk.temperature.action.airflow": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cải thiện thoáng khí hoặc đổi vị trí ổ ngoài."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Improve airflow or move the external drive."
          }
        }
      }
    },
    "risk.temperature.action.recheck": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra lại nhiệt độ khi đang copy dữ liệu lớn."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recheck temperature during a large copy."
          }
        }
      }
    },
    "risk.temperature.message": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ổ đang hơi nóng. Nhiệt cao kéo dài có thể làm giảm tuổi thọ và tăng lỗi đọc/ghi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The drive is running warm. Sustained heat can shorten lifespan and increase read/write errors."
          }
        }
      }
    },
    "risk.temperature.title": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Theo dõi nhiệt độ"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch temperature"
          }
        }
      }
    },
    "risk.unsupported.action.backup": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra dữ liệu bằng backup gần nhất."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify data against the latest backup."
          }
        }
      }
    },
    "risk.unsupported.action.io": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Theo dõi lỗi I/O trong kernel log nếu ổ hay ngắt kết nối."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch kernel I/O errors if the drive disconnects often."
          }
        }
      }
    },
    "risk.unsupported.action.passthrough": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thử cáp hoặc hộp ổ khác có SMART passthrough."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try another cable or enclosure with SMART passthrough."
          }
        }
      }
    },
    "risk.unsupported.message": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS không đọc được SMART qua kênh hiện tại. Nếu đây là ổ quan trọng, hãy thử hộp Thunderbolt/NVMe hoặc kết nối SATA trực tiếp."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS cannot read SMART through the current connection. For important drives, try Thunderbolt/NVMe or direct SATA."
          }
        }
      }
    },
    "risk.unsupported.title": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "SMART không khả dụng"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SMART unavailable"
          }
        }
      }
    },
    "notify.backup.title": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhắc backup: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup reminder: %@"
          }
        }
      }
    },
    "notify.backup.body": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ổ đang ở mức %@. Hãy xác nhận backup gần nhất còn dùng được trước khi tiếp tục ghi dữ liệu quan trọng."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The drive is at %@. Confirm your latest backup is usable before writing more important data."
          }
        }
      }
    },
