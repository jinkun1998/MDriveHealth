    "Theo dõi nền & cảnh báo": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Theo dõi nền & cảnh báo"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background monitoring & alerts"
          }
        }
      }
    },
    "Lưu ý về ổ USB": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu ý về ổ USB"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A note about USB drives"
          }
        }
      }
    },
    "MDriveHealth chấm điểm từng ổ dựa trên các chỉ báo SMART trọng yếu (sector lỗi, media error, độ mòn SSD…). 90+ là Tốt; dưới 50 là lúc cần sao lưu và tính chuyện thay ổ.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "MDriveHealth chấm điểm từng ổ dựa trên các chỉ báo SMART trọng yếu (sector lỗi, media error, độ mòn SSD…). 90+ là Tốt; dưới 50 là lúc cần sao lưu và tính chuyện thay ổ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MDriveHealth scores each drive from the SMART indicators that matter (bad sectors, media errors, SSD wear…). 90+ is Good; below 50 means back up and plan a replacement."
          }
        }
      }
    },
    "App âm thầm đọc SMART định kỳ và chỉ lên tiếng khi có chuyện: sức khoẻ giảm, xuất hiện sector lỗi mới, quá nhiệt, hay self-test xong. macOS sẽ hỏi quyền thông báo — hãy bấm Cho phép.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "App âm thầm đọc SMART định kỳ và chỉ lên tiếng khi có chuyện: sức khoẻ giảm, xuất hiện sector lỗi mới, quá nhiệt, hay self-test xong. macOS sẽ hỏi quyền thông báo — hãy bấm Cho phép."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app quietly polls SMART and only speaks up when something happens: health drops, new bad sectors, overheating, or a finished self-test. macOS will ask for notification permission — click Allow."
          }
        }
      }
    },
    "Để theo dõi liên tục kể cả sau khi khởi động lại máy, cho app tự chạy khi đăng nhập. Icon nằm gọn trên menu bar, không làm phiền.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để theo dõi liên tục kể cả sau khi khởi động lại máy, cho app tự chạy khi đăng nhập. Icon nằm gọn trên menu bar, không làm phiền."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To keep monitoring across restarts, let the app launch at login. It sits quietly in the menu bar."
          }
        }
      }
    },
    "macOS không cho đọc SMART qua cầu USB thường — đây là giới hạn hệ điều hành, KHÔNG phải lỗi ổ hay lỗi app. Với ổ USB, mày vẫn đo được tốc độ và kiểm tra dung lượng thật (bắt ổ fake) ở tab Tốc độ.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS không cho đọc SMART qua cầu USB thường — đây là giới hạn hệ điều hành, KHÔNG phải lỗi ổ hay lỗi app. Với ổ USB, mày vẫn đo được tốc độ và kiểm tra dung lượng thật (bắt ổ fake) ở tab Tốc độ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS can't read SMART across ordinary USB bridges — an OS limitation, not a drive or app fault. For USB drives you can still benchmark speed and verify real capacity (catch fakes) in the Speed tab."
          }
        }
      }
    },
    "Đẩy an toàn": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đẩy an toàn"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safe eject"
          }
        }
      }
    },
    "Unmount toàn bộ volume của ổ này; nếu bị kẹt sẽ chỉ ra app nào đang giữ file": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Unmount toàn bộ volume của ổ này; nếu bị kẹt sẽ chỉ ra app nào đang giữ file"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unmounts every volume on this drive; if it's stuck, shows which app is holding files"
